{% extends 'layout.twig' %}

{% block title %}{{ task.title }} &middot; Task Tracker{% endblock %}

{% block content %}
{% set status_colors = {'open': 'secondary', 'in_progress': 'primary', 'blocked': 'warning', 'done': 'success'} %}
{% set priority_colors = {'low': 'info', 'med': 'secondary', 'high': 'warning', 'critical': 'danger'} %}

<div class="mb-3">
    <a class="btn btn-link btn-sm px-0" href="/">&larr; Back to backlog</a>
</div>

<h1 class="h3 mb-3" data-id="{{ task.id }}">{{ task.title }}</h1>

<div class="mb-3">
    <span class="badge bg-{{ status_colors[task.status]|default('secondary') }}">{{ task.status }}</span>
    <span class="badge bg-{{ priority_colors[task.priority]|default('secondary') }}">{{ task.priority }}</span>
    {% if task.slug %}<span class="badge bg-light text-dark border"><code>{{ task.slug }}</code></span>{% endif %}
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <dl class="row task-fields mb-0">
            <dt class="col-sm-4">ID</dt>          <dd class="col-sm-8"><code>{{ task.id }}</code></dd>
            <dt class="col-sm-4">Due</dt>         <dd class="col-sm-8">{{ task.dueDate ?? '—' }}</dd>
            <dt class="col-sm-4">Effort (h)</dt>  <dd class="col-sm-8">{{ task.effortHours ?? '—' }}</dd>
            <dt class="col-sm-4">URL</dt>         <dd class="col-sm-8">{% if task.url %}<a href="{{ task.url }}">{{ task.url }}</a>{% else %}—{% endif %}</dd>
        </dl>
    </div>
    <div class="col-md-6">
        <dl class="row task-fields mb-0">
            <dt class="col-sm-4">Parent</dt>      <dd class="col-sm-8">{{ task.parentId ?? '—' }}</dd>
            <dt class="col-sm-4">Assignee</dt>    <dd class="col-sm-8">{{ task.assigneeId ?? '—' }}</dd>
            <dt class="col-sm-4">Team</dt>        <dd class="col-sm-8">{{ task.teamId ?? '—' }}</dd>
            <dt class="col-sm-4">Created</dt>     <dd class="col-sm-8"><time>{{ task.createdAt }}</time></dd>
            <dt class="col-sm-4">Updated</dt>     <dd class="col-sm-8"><time>{{ task.updatedAt }}</time></dd>
            <dt class="col-sm-4">Completed</dt>   <dd class="col-sm-8">{{ task.completedAt ? '<time>' ~ task.completedAt ~ '</time>'|raw : '—' }}</dd>
        </dl>
    </div>
</div>

{% if task.body %}
<section class="task-body mb-4">
    <h2 class="h5">Body</h2>
    <pre class="border bg-white p-3 small">{{ task.body }}</pre>
</section>
{% endif %}

<section class="activity-feed">
    <h2 class="h5">Activity</h2>
    {% if feed is empty %}
        <p class="text-muted empty">No activity recorded.</p>
    {% else %}
        <ol class="list-group list-group-numbered">
        {% for event in feed %}
            <li class="list-group-item d-flex justify-content-between align-items-start"
                data-action="{{ event.action }}" data-ts="{{ event.ts }}">
                <div class="ms-2 me-auto">
                    <div><code>{{ event.action }}</code></div>
                    {% if event.data is not empty %}
                        <small class="text-muted">
                            {%- for key, value in event.data -%}
                                {{ key }}={{ value is iterable ? value|json_encode : value }}{% if not loop.last %} &middot; {% endif %}
                            {%- endfor -%}
                        </small>
                    {% endif %}
                </div>
                <time class="badge bg-light text-dark border">{{ event.ts }}</time>
            </li>
        {% endfor %}
        </ol>
    {% endif %}
</section>
{% endblock %}

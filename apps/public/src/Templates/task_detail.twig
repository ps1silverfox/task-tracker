{% extends 'layout.twig' %}

{% block title %}{{ task.title }} &middot; Task Tracker{% endblock %}

{% set status_colors   = {'open': 'secondary', 'in_progress': 'primary', 'blocked': 'warning', 'done': 'success'} %}
{% set priority_colors = {'low': 'info', 'med': 'secondary', 'high': 'warning', 'critical': 'danger'} %}

{# Defaults for optional context vars so direct template rendering stays safe #}
{% set tags        = tags        ?? [] %}
{% set prereqs     = prereqs     ?? [] %}
{% set subtasks    = subtasks    ?? [] %}
{% set assigneeMap = assigneeMap ?? {} %}
{% set teamMap     = teamMap     ?? {} %}
{% set assigneeName = assigneeName ?? (assigneeMap[task.assigneeId] ?? task.assigneeId ?? null) %}
{% set teamName     = teamName     ?? (teamMap[task.teamId]         ?? task.teamId     ?? null) %}

{% block content %}
<div class="mb-3">
    <a class="btn btn-link btn-sm px-0" href="/">&larr; Back to backlog</a>
</div>

<h1 class="h3 mb-3" data-id="{{ task.id }}">{{ task.title }}</h1>

<div class="mb-3">
    <span class="badge bg-{{ status_colors[task.status]|default('secondary') }}">{{ task.status }}</span>
    <span class="badge bg-{{ priority_colors[task.priority]|default('secondary') }}">{{ task.priority }}</span>
    {% if task.slug %}<span class="badge bg-light text-dark border"><code>{{ task.slug }}</code></span>{% endif %}
    {% for tag in tags %}
        <span class="badge bg-primary">{{ tag }}</span>
    {% endfor %}
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <dl class="row task-fields mb-0">
            <dt class="col-sm-4">ID</dt>          <dd class="col-sm-8"><code>{{ task.id }}</code></dd>
            <dt class="col-sm-4">Due</dt>         <dd class="col-sm-8">{{ task.dueDate ?? '—' }}</dd>
            <dt class="col-sm-4">Effort (h)</dt>  <dd class="col-sm-8">{{ task.effortHours ?? '—' }}</dd>
            <dt class="col-sm-4">URL</dt>         <dd class="col-sm-8">{% if task.url %}<a href="{{ task.url }}">{{ task.url }}</a>{% else %}—{% endif %}</dd>
        </dl>
    </div>
    <div class="col-md-6">
        <dl class="row task-fields mb-0">
            <dt class="col-sm-4">Parent</dt>      <dd class="col-sm-8">{{ task.parentId ?? '—' }}</dd>
            <dt class="col-sm-4">Assignee</dt>    <dd class="col-sm-8">{{ assigneeName ?? '—' }}</dd>
            <dt class="col-sm-4">Team</dt>        <dd class="col-sm-8">{{ teamName ?? '—' }}</dd>
            <dt class="col-sm-4">Created</dt>     <dd class="col-sm-8"><time>{{ task.createdAt }}</time></dd>
            <dt class="col-sm-4">Updated</dt>     <dd class="col-sm-8"><time>{{ task.updatedAt }}</time></dd>
            <dt class="col-sm-4">Completed</dt>   <dd class="col-sm-8">{% if task.completedAt %}<time>{{ task.completedAt }}</time>{% else %}—{% endif %}</dd>
        </dl>
    </div>
</div>

{% if task.body %}
<section class="task-body mb-4">
    <h2 class="h5">Body</h2>
    <pre class="border bg-white p-3 small">{{ task.body }}</pre>
</section>
{% endif %}

{% if prereqs is not empty %}
<section class="prereqs mb-4">
    <h2 class="h5">Prerequisites</h2>
    <ul class="list-group list-group-flush">
        {% for p in prereqs %}
        <li class="list-group-item px-0">
            <a href="/tasks/{{ p.id|url_encode }}">{{ p.slug }} · {{ p.title }}</a>
            <span class="badge bg-{{ status_colors[p.status]|default('secondary') }} ms-2">{{ p.status }}</span>
        </li>
        {% endfor %}
    </ul>
</section>
{% endif %}

{% if subtasks is not empty %}
<section class="subtasks mb-4">
    <h2 class="h5">Subtasks</h2>
    <ul class="list-group list-group-flush">
        {% for s in subtasks %}
        <li class="list-group-item px-0">
            <a href="/tasks/{{ s.id|url_encode }}">{{ s.slug }} · {{ s.title }}</a>
            <span class="badge bg-{{ status_colors[s.status]|default('secondary') }} ms-2">{{ s.status }}</span>
        </li>
        {% endfor %}
    </ul>
</section>
{% endif %}

<section class="activity-feed">
    <h2 class="h5">Activity</h2>
    {% if feed is empty %}
        <p class="text-muted empty">No activity recorded.</p>
    {% else %}
        <ol class="list-group list-group-numbered">
        {% for event in feed %}
            <li class="list-group-item d-flex justify-content-between align-items-start"
                data-action="{{ event.action }}" data-ts="{{ event.ts }}">
                <div class="ms-2 me-auto">
                    <div><code>{{ event.action }}</code></div>
                    {% if event.data is not empty %}
                        <small class="text-muted">
                            {%- for key, value in event.data -%}
                                {{ key }}={{ value is iterable ? value|json_encode : value }}{% if not loop.last %} &middot; {% endif %}
                            {%- endfor -%}
                        </small>
                    {% endif %}
                </div>
                <time class="badge bg-light text-dark border">{{ event.ts }}</time>
            </li>
        {% endfor %}
        </ol>
    {% endif %}
</section>
{% endblock %}

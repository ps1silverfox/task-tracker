{% extends 'layout.twig' %}

{% block title %}Dependency Graph &middot; Task Tracker{% endblock %}

{# Defaults so direct template rendering stays safe #}
{% set status_filter  = status_filter  ?? [] %}
{% set statuses_live  = statuses_live  ?? ['open','in_progress','blocked','done'] %}
{% set team_id        = team_id        ?? '' %}
{% set root           = root           ?? '' %}
{% set json_url       = json_url       ?? '/graph.json' %}
{% set node_ceiling   = node_ceiling   ?? 200 %}

{% block content %}
<div class="mb-3">
    <h1 class="h3 mb-1">Dependency Graph</h1>
    <p class="text-muted small mb-0">Arrow direction: prereq &rarr; blocked task.
        Node fill&nbsp;= status &middot; border&nbsp;= priority.
        Click a node to open its detail page.</p>
</div>

{# ── Filter bar ── #}
<form method="get" action="/graph" class="row g-2 mb-3 align-items-end p-3 bg-white border rounded"
      id="graph-filters">
    <div class="col-12 col-md-auto">
        <label class="form-label small mb-1 d-block">Status</label>
        <div class="d-flex flex-wrap gap-2">
            {% for s in statuses_live %}
            <div class="form-check form-check-inline mb-0">
                <input class="form-check-input" type="checkbox" name="status_pick"
                       id="s-{{ s }}" value="{{ s }}"
                       {% if s in status_filter %}checked{% endif %}>
                <label class="form-check-label small" for="s-{{ s }}">{{ s }}</label>
            </div>
            {% endfor %}
        </div>
        <input type="hidden" name="status" id="status-input"
               value="{{ status_filter|join(',') }}">
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-team" class="form-label small mb-1">Team ID</label>
        <input id="f-team" type="text" name="team_id" class="form-control form-control-sm"
               placeholder="uuid" value="{{ team_id }}">
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-root" class="form-label small mb-1">Root subtree</label>
        <input id="f-root" type="text" name="root" class="form-control form-control-sm"
               placeholder="task id" value="{{ root }}">
    </div>
    <div class="col-sm-6 col-md-auto d-flex gap-1">
        <button type="submit" class="btn btn-sm btn-outline-primary">Apply</button>
        <a href="/graph" class="btn btn-sm btn-outline-secondary">Clear</a>
    </div>
</form>

{# ── Threshold warning ── #}
<div id="graph-banner" hidden
     class="alert alert-warning py-2 mb-2"
     data-node-ceiling="{{ node_ceiling }}" role="alert">
    Graph exceeds {{ node_ceiling }} nodes &mdash; consider tightening filters
    (status, team, or root subtree).
</div>

{# ── Canvas ── #}
<div id="graph-canvas"
     class="border rounded bg-white"
     style="width:100%;height:680px"
     data-json-url="{{ json_url }}"></div>

<script src="/vendor/cytoscape/cytoscape.min.js"></script>
<script src="/vendor/cytoscape/cytoscape-dagre.min.js"></script>
<script>
(function () {
    // Collapse the status checkbox group into the single hidden field the
    // controller expects (comma-separated).
    var form = document.getElementById('graph-filters');
    if (form) {
        form.addEventListener('submit', function () {
            var picks = Array.prototype.map.call(
                form.querySelectorAll('input[name="status_pick"]:checked'),
                function (el) { return el.value; }
            );
            document.getElementById('status-input').value = picks.join(',');
            Array.prototype.forEach.call(
                form.querySelectorAll('input[name="status_pick"]'),
                function (el) { el.disabled = true; }
            );
        });
    }

    var container = document.getElementById('graph-canvas');
    if (!container || typeof cytoscape === 'undefined') { return; }
    var jsonUrl = container.getAttribute('data-json-url') || '/graph.json';
    var banner  = document.getElementById('graph-banner');

    var statusFill = {
        open: '#9ca3af', in_progress: '#3b82f6',
        blocked: '#ef4444', done: '#10b981'
    };
    var priorityBorder = {
        low: '#9ca3af', med: '#000000',
        high: '#f59e0b', critical: '#ef4444'
    };

    fetch(jsonUrl, { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (banner && data.meta && data.meta.exceeds_threshold) {
                banner.hidden = false;
            }
            var elements = (data.nodes || []).concat(data.edges || []);
            var cy = cytoscape({
                container: container,
                elements: elements,
                style: [
                    {
                        selector: 'node',
                        style: {
                            'label': 'data(label)',
                            'background-color': function (ele) {
                                return statusFill[ele.data('status')] || '#9ca3af';
                            },
                            'border-color': function (ele) {
                                return priorityBorder[ele.data('priority')] || '#000';
                            },
                            'border-width': 2,
                            'text-valign': 'center',
                            'text-halign': 'center',
                            'color': '#111',
                            'font-size': 10
                        }
                    },
                    {
                        selector: 'edge',
                        style: {
                            'curve-style': 'bezier',
                            'target-arrow-shape': 'triangle',
                            'arrow-scale': 1.2,
                            'line-color': '#888',
                            'target-arrow-color': '#888',
                            'width': 1.5
                        }
                    }
                ],
                layout: {
                    name: typeof window.cytoscapeDagre !== 'undefined' ? 'dagre' : 'breadthfirst'
                }
            });
            cy.on('tap', 'node', function (evt) {
                var id = evt.target.id();
                if (id) { window.location.href = '/tasks/' + encodeURIComponent(id); }
            });
        });
})();
</script>
{% endblock %}

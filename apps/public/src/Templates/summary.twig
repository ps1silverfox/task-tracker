{% extends 'layout.twig' %}

{% block title %}Executive Summary &middot; Task Tracker{% endblock %}

{# Defaults so direct template rendering stays safe #}
{% set period = period ?? 'month' %}
{% set from   = from   ?? '' %}
{% set to     = to     ?? '' %}
{% set person = person ?? null %}
{% set team   = team   ?? null %}
{% set rows   = rows   ?? [] %}
{% set series = series ?? {labels:[], added:[], completed:[], assigned:[], unassigned:[]} %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Executive Summary</h1>
    <a class="btn btn-outline-secondary btn-sm"
       href="/summary.csv?period={{ period|url_encode }}&from={{ from|url_encode }}&to={{ to|url_encode }}{% if person %}&person={{ person|url_encode }}{% endif %}{% if team %}&team={{ team|url_encode }}{% endif %}">Export CSV</a>
</div>

{# ── Filter bar ── #}
<form method="get" action="/summary" class="row g-2 mb-4 align-items-end p-3 bg-white border rounded">
    <div class="col-sm-6 col-md-2">
        <label for="f-period" class="form-label small mb-1">Period</label>
        <select id="f-period" name="period" class="form-select form-select-sm">
            {% for p in ['day', 'month', 'quarter', 'year'] %}
                <option value="{{ p }}"{% if period == p %} selected{% endif %}>{{ p }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-from" class="form-label small mb-1">From</label>
        <input id="f-from" type="date" name="from" class="form-control form-control-sm" value="{{ from }}">
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-to" class="form-label small mb-1">To</label>
        <input id="f-to" type="date" name="to" class="form-control form-control-sm" value="{{ to }}">
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-person" class="form-label small mb-1">Person</label>
        <input id="f-person" type="text" name="person" class="form-control form-control-sm"
               placeholder="roster id" value="{{ person ?? '' }}">
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-team" class="form-label small mb-1">Team</label>
        <input id="f-team" type="text" name="team" class="form-control form-control-sm"
               placeholder="team id" value="{{ team ?? '' }}">
    </div>
    <div class="col-sm-6 col-md-2 d-flex gap-1">
        <button type="submit" class="btn btn-sm btn-outline-primary flex-grow-1">Apply</button>
        <a href="/summary" class="btn btn-sm btn-outline-secondary">Clear</a>
    </div>
</form>

{# ── Chart ── #}
<div class="card mb-4">
    <div class="card-body p-2">
        <canvas id="summary-chart"
                class="w-100"
                style="max-height:320px"
                data-labels="{{ series.labels|json_encode|e('html_attr') }}"
                data-added="{{ series.added|json_encode|e('html_attr') }}"
                data-completed="{{ series.completed|json_encode|e('html_attr') }}"
                data-assigned="{{ series.assigned|json_encode|e('html_attr') }}"
                data-unassigned="{{ series.unassigned|json_encode|e('html_attr') }}"></canvas>
    </div>
</div>

{# ── Summary table ── #}
{% if rows is empty %}
    <div class="alert alert-info" role="alert">No events in the selected date range.</div>
{% else %}
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle" id="summary-table">
        <thead class="table-dark">
            <tr>
                <th scope="col">Period</th>
                <th scope="col" class="text-end">Added</th>
                <th scope="col" class="text-end">Completed</th>
                <th scope="col" class="text-end">Assigned</th>
                <th scope="col" class="text-end">Unassigned</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
            <tr data-period="{{ row.period }}">
                <td><code>{{ row.period }}</code></td>
                <td class="text-end">{{ row.added }}</td>
                <td class="text-end">{{ row.completed }}</td>
                <td class="text-end">{{ row.assigned }}</td>
                <td class="text-end">{{ row.unassigned }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<script src="/vendor/chartjs/chart.umd.min.js"></script>
<script>
(function () {
    var canvas = document.getElementById('summary-chart');
    if (!canvas || typeof Chart === 'undefined') { return; }
    var labels     = JSON.parse(canvas.getAttribute('data-labels')     || '[]');
    var added      = JSON.parse(canvas.getAttribute('data-added')      || '[]');
    var completed  = JSON.parse(canvas.getAttribute('data-completed')  || '[]');
    var assigned   = JSON.parse(canvas.getAttribute('data-assigned')   || '[]');
    var unassigned = JSON.parse(canvas.getAttribute('data-unassigned') || '[]');
    new Chart(canvas, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                { label: 'Added',      data: added,      backgroundColor: '#3b82f6' },
                { label: 'Completed',  data: completed,  backgroundColor: '#10b981' },
                { label: 'Assigned',   data: assigned,   backgroundColor: '#f59e0b' },
                { label: 'Unassigned', data: unassigned, backgroundColor: '#ef4444' }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } },
            plugins: { legend: { position: 'top' } }
        }
    });
})();
</script>
{% endblock %}

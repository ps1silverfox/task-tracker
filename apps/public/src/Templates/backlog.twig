{% extends 'layout.twig' %}

{% block title %}Backlog &middot; Task Tracker{% endblock %}

{% set status_colors   = {'open': 'secondary', 'in_progress': 'primary', 'blocked': 'warning', 'done': 'success'} %}
{% set priority_colors = {'low': 'info', 'med': 'secondary', 'high': 'warning', 'critical': 'danger'} %}

{# Defaults so template renders safely when invoked directly from tests #}
{% set assigneeMap   = assigneeMap   ?? {} %}
{% set teamMap       = teamMap       ?? {} %}
{% set filterParams  = filterParams  ?? {} %}
{% set roster        = roster        ?? [] %}
{% set teams         = teams         ?? [] %}
{% set savedViews    = savedViews    ?? [] %}
{% set query_string  = query_string  ?? '' %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Backlog <span class="badge bg-secondary">{{ tasks|length }}</span></h1>
    <a class="btn btn-outline-secondary btn-sm"
       href="/tasks.csv{% if query_string %}?{{ query_string }}{% endif %}">Export CSV</a>
</div>

{# ── Filter bar (UI-06) ── #}
<form method="get" action="/" class="row g-2 mb-3 align-items-end p-3 bg-white border rounded">
    <div class="col-sm-6 col-md-2">
        <label for="f-status" class="form-label small mb-1">Status</label>
        <select id="f-status" name="status" class="form-select form-select-sm">
            <option value="">All statuses</option>
            {% for s in ['open','in_progress','blocked','done'] %}
                <option value="{{ s }}"{% if filterParams.status is defined and filterParams.status == s %} selected{% endif %}>{{ s }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">

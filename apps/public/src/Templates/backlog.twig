{% extends 'layout.twig' %}

{% block title %}Backlog &middot; Task Tracker{% endblock %}

{% set status_colors   = {'open': 'secondary', 'in_progress': 'primary', 'blocked': 'warning', 'done': 'success'} %}
{% set priority_colors = {'low': 'info', 'med': 'secondary', 'high': 'warning', 'critical': 'danger'} %}

{# Defaults so template renders safely when invoked directly from tests #}
{% set assigneeMap   = assigneeMap   ?? {} %}
{% set teamMap       = teamMap       ?? {} %}
{% set filterParams  = filterParams  ?? {} %}
{% set roster        = roster        ?? [] %}
{% set teams         = teams         ?? [] %}
{% set savedViews    = savedViews    ?? [] %}
{% set query_string  = query_string  ?? '' %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Backlog <span class="badge bg-secondary">{{ tasks|length }}</span></h1>
    <a class="btn btn-outline-secondary btn-sm"
       href="/tasks.csv{% if query_string %}?{{ query_string }}{% endif %}">Export CSV</a>
</div>

{# ── Filter bar (UI-06) ── #}
<form method="get" action="/" class="row g-2 mb-3 align-items-end p-3 bg-white border rounded">
    <div class="col-sm-6 col-md-2">
        <label for="f-status" class="form-label small mb-1">Status</label>
        <select id="f-status" name="status" class="form-select form-select-sm">
            <option value="">All statuses</option>
            {% for s in ['open','in_progress','blocked','done'] %}
                <option value="{{ s }}"{% if filterParams.status is defined and filterParams.status == s %} selected{% endif %}>{{ s }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-priority" class="form-label small mb-1">Priority</label>
        <select id="f-priority" name="priority" class="form-select form-select-sm">
            <option value="">All priorities</option>
            {% for p in ['low','med','high','critical'] %}
                <option value="{{ p }}"{% if filterParams.priority is defined and filterParams.priority == p %} selected{% endif %}>{{ p }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-team" class="form-label small mb-1">Team</label>
        <select id="f-team" name="team_id" class="form-select form-select-sm">
            <option value="">All teams</option>
            {% for t in teams %}
                <option value="{{ t.id }}"{% if filterParams.team_id is defined and filterParams.team_id == t.id %} selected{% endif %}>{{ t.name }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-assignee" class="form-label small mb-1">Assignee</label>
        <select id="f-assignee" name="assignee_id" class="form-select form-select-sm">
            <option value="">All assignees</option>
            {% for m in roster %}
                <option value="{{ m.id }}"{% if filterParams.assignee_id is defined and filterParams.assignee_id == m.id %} selected{% endif %}>{{ m.name }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-tags" class="form-label small mb-1">Tag</label>
        <input id="f-tags" type="text" name="tags" class="form-control form-control-sm"
               placeholder="tag1,tag2"
               value="{{ filterParams.tags ?? '' }}">
    </div>
    <div class="col-sm-6 col-md-2 d-flex gap-1">
        <button type="submit" class="btn btn-sm btn-outline-primary flex-grow-1">Filter</button>
        <a href="/" class="btn btn-sm btn-outline-secondary">Clear</a>
    </div>
</form>

{% if savedViews is not empty %}
<div class="mb-3 d-flex flex-wrap gap-1">
    <span class="small text-muted me-1 align-self-center">Saved views:</span>
    {% for view in savedViews %}
        <a href="/views/{{ view.id|url_encode }}" class="btn btn-sm btn-outline-info">{{ view.name }}</a>
    {% endfor %}
</div>
{% endif %}

{% if tasks is empty %}
    <div class="alert alert-info" role="alert">No tasks match the current filter.</div>
{% else %}
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">Slug</th>
                <th scope="col">Title</th>
                <th scope="col">Status</th>
                <th scope="col">Priority</th>
                <th scope="col">Assignee</th>
                <th scope="col">Due</th>
            </tr>
        </thead>
        <tbody>
            {% for task in tasks %}
            <tr data-id="{{ task.id }}">
                <td><code>{{ task.slug }}</code></td>
                <td><a href="/tasks/{{ task.id|url_encode }}">{{ task.title }}</a></td>
                <td><span class="badge bg-{{ status_colors[task.status]|default('secondary') }}">{{ task.status }}</span></td>
                <td><span class="badge bg-{{ priority_colors[task.priority]|default('secondary') }}">{{ task.priority }}</span></td>
                <td>{{ assigneeMap[task.assigneeId] ?? task.assigneeId ?? '—' }}</td>
                <td>{{ task.dueDate ?? '—' }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}

{% extends 'layout.twig' %}

{% block title %}Backlog · Task Tracker · Admin{% endblock %}

{% set status_colors   = {'open': 'secondary', 'in_progress': 'primary', 'blocked': 'warning', 'done': 'success'} %}
{% set priority_colors = {'low': 'info', 'med': 'secondary', 'high': 'warning', 'critical': 'danger'} %}

{# Default maps so the template renders cleanly when called from unit tests
   that don't inject the full context (e.g. RenderingTest). #}
{% set assigneeMap   = assigneeMap   ?? {} %}
{% set teamMap       = teamMap       ?? {} %}
{% set activeFilters = activeFilters ?? {} %}
{% set roster        = roster        ?? [] %}
{% set teams         = teams         ?? [] %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Backlog <span class="badge bg-secondary">{{ tasks|length }}</span></h1>
    <a class="btn btn-primary btn-sm" href="/tasks/new">+ New task</a>
</div>

{# ── Filter bar (UI-03) ── #}
<form method="get" action="/" class="row g-2 mb-3 align-items-end p-3 bg-white border rounded">
    <div class="col-sm-6 col-md-2">
        <label for="f-status" class="form-label small mb-1">Status</label>
        <select id="f-status" name="status" class="form-select form-select-sm">
            <option value="">All statuses</option>
            {% for s in ['open','in_progress','blocked','done'] %}
                <option value="{{ s }}"{% if activeFilters.status is defined and activeFilters.status == s %} selected{% endif %}>{{ s }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-priority" class="form-label small mb-1">Priority</label>
        <select id="f-priority" name="priority" class="form-select form-select-sm">
            <option value="">All priorities</option>
            {% for p in ['low','med','high','critical'] %}
                <option value="{{ p }}"{% if activeFilters.priority is defined and activeFilters.priority == p %} selected{% endif %}>{{ p }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-team" class="form-label small mb-1">Team</label>
        <select id="f-team" name="team_id" class="form-select form-select-sm">
            <option value="">All teams</option>
            {% for t in teams %}
                <option value="{{ t.id }}"{% if activeFilters.team_id is defined and activeFilters.team_id == t.id %} selected{% endif %}>{{ t.name }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-assignee" class="form-label small mb-1">Assignee</label>
        <select id="f-assignee" name="assignee_id" class="form-select form-select-sm">
            <option value="">All assignees</option>
            {% for m in roster %}
                <option value="{{ m.id }}"{% if activeFilters.assignee_id is defined and activeFilters.assignee_id == m.id %} selected{% endif %}>{{ m.name }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-tags" class="form-label small mb-1">Tag</label>
        <input id="f-tags" type="text" name="tags" class="form-control form-control-sm"
               placeholder="tag1,tag2"
               value="{{ activeFilters.tags ?? '' }}">
    </div>
    <div class="col-sm-6 col-md-2 d-flex gap-1">
        <button type="submit" class="btn btn-sm btn-outline-primary flex-grow-1">Filter</button>
        <a href="/" class="btn btn-sm btn-outline-secondary">Clear</a>
    </div>
</form>

{% if tasks is empty %}
    <div class="alert alert-info" role="alert">
        No tasks yet. <a href="/tasks/new" class="alert-link">Create the first one</a>.
    </div>
{% else %}
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">Slug</th>
                <th scope="col">Title</th>
                <th scope="col">Status</th>
                <th scope="col">Priority</th>
                <th scope="col">Assignee</th>
                <th scope="col">Due</th>
                <th scope="col" class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for task in tasks %}
            <tr data-id="{{ task.id }}">
                <td><code>{{ task.slug }}</code></td>
                <td>{{ task.title }}</td>
                <td><span class="badge bg-{{ status_colors[task.status]|default('secondary') }}">{{ task.status }}</span></td>
                <td><span class="badge bg-{{ priority_colors[task.priority]|default('secondary') }}">{{ task.priority }}</span></td>
                <td>{{ assigneeMap[task.assigneeId] ?? task.assigneeId ?? '—' }}</td>
                <td>{{ task.dueDate ?? '—' }}</td>
                <td class="text-end">
                    <a class="btn btn-outline-primary btn-sm" href="/tasks/{{ task.id|url_encode }}">Edit</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}

{% extends 'layout.twig' %}

{% block title %}Backlog · Task Tracker · Admin{% endblock %}

{% set status_colors   = {'open': 'secondary', 'in_progress': 'primary', 'blocked': 'warning', 'done': 'success'} %}
{% set priority_colors = {'low': 'info', 'med': 'secondary', 'high': 'warning', 'critical': 'danger'} %}

{# Default maps so the template renders cleanly when called from unit tests
   that don't inject the full context (e.g. RenderingTest). #}
{% set assigneeMap   = assigneeMap   ?? {} %}
{% set teamMap       = teamMap       ?? {} %}
{% set activeFilters = activeFilters ?? {} %}
{% set roster        = roster        ?? [] %}
{% set teams         = teams         ?? [] %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Backlog <span class="badge bg-secondary">{{ tasks|length }}</span></h1>
    <a class="btn btn-primary btn-sm" href="/tasks/new">+ New task</a>
</div>

{# ── Filter bar (UI-03) ── #}
<form method="get" action="/" class="row g-2 mb-3 align-items-end p-3 bg-white border rounded">
    <div class="col-sm-6 col-md-2">
        <label for="f-status" class="form-label small mb-1">Status</label>
        <select id="f-status" name="status" class="form-select form-select-sm">
            <option value="">All statuses</option>
            {% for s in ['open','in_progress','blocked','done'] %}
                <option value="{{ s }}"{% if activeFilters.status is defined and activeFilters.status == s %} selected{% endif %}>{{ s }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-priority" class="form-label small mb-1">Priority</label>
        <select id="f-priority" name="priority" class="form-select form-select-sm">
            <option value="">All priorities</option>
            {% for p in ['low','med','high','critical'] %}
                <option value="{{ p }}"{% if activeFilters.priority is defined and activeFilters.priority == p %} selected{% endif %}>{{ p }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <label for="f-team" class="form-label small mb-1">Team</label>
  
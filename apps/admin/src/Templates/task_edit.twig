{% extends 'layout.twig' %}

{% block title %}{% if task is null %}New task{% else %}Edit {{ task.slug }}{% endif %} · Admin{% endblock %}

{# Defaults so the template is safe to render from RenderingTest without all context vars. #}
{% set currentTags   = currentTags   ?? [] %}
{% set currentDeps   = currentDeps   ?? [] %}
{% set parentOptions = parentOptions ?? [] %}

{% block content %}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Backlog</a></li>
        <li class="breadcrumb-item active" aria-current="page">
            {% if task is null %}New task{% else %}{{ task.slug }}{% endif %}
        </li>
    </ol>
</nav>

<h1 class="h3 mb-3">{% if task is null %}New task{% else %}Edit task{% endif %}</h1>

<form method="post" action="{% if task is null %}/tasks{% else %}/tasks/{{ task.id|url_encode }}{% endif %}" class="row g-3">
    <div class="col-md-4">
        <label for="slug" class="form-label">Slug</label>
        <input type="text" class="form-control" id="slug" name="slug"
               value="{{ task.slug ?? '' }}" required pattern="[a-z0-9-]+">
        <div class="form-text">lowercase, digits, dashes only</div>
    </div>

    <div class="col-md-8">
        <label for="title" class="form-label">Title</label>
        <input type="text" class="form-control" id="title" name="title"
               value="{{ task.title ?? '' }}" required>
    </div>

    <div class="col-12">
        <label for="body" class="form-label">Body</label>
        <textarea class="form-control" id="body" name="body" rows="4">{{ task.body ?? '' }}</textarea>
    </div>

    <div class="col-md-3">
        <label for="status" class="form-label">Status</label>
        <select class="form-select" id="status" name="status">
            {% for s in statuses %}
                <option value="{{ s }}"{% if task and task.status == s %} selected{% endif %}>{{ s }}</option>
            {% endfor %}
        </select>
    </div>

    <div class="col-md-3">
        <label for="priority" class="form-label">Priority</label>
        <select class="form-select" id="priority" name="priority">
            {% for p in priorities %}
                <option value="{{ p }}"{% if task and task.priority == p %} selected{% endif %}>{{ p }}</option>
            {% endfor %}
        </select>
    </div>

    <div class="col-md-3">
        <label for="due_date" class="form-label">Due date</label>
        <input type="date" class="form-control" id="due_date" name="due_date"
               value="{{ task.dueDate ?? '' }}">
    </div>

    <div class="col-md-3">
        <label for="effort_hours" class="form-label">Effort (hours)</label>
        <input type="number" min="0" step="0.25" class="form-control"
               id="effort_hours" name="effort_hours"
               value="{{ task.effortHours ?? '' }}">
    </div>

    <div class="col-md-4">
        <label for="assignee_id" class="form-label">Assignee</label>
        <select class="form-select" id="assignee_id" name="assignee_id">
            <option value="">— unassigned —</option>
            {% for m in roster %}
                <option value="{{ m.id }}"{% if task and task.assigneeId == m.id %} selected{% endif %}>
                    {{ m.name }}{% if not m.active %} (inactive){% endif %}
                </option>
            {% endfor %}
        </select>
    </div>

    <div class="col-md-4">
        <label for="team_id" class="form-label">Team</label>
        <select class="form-select" id="team_id" name="team_id">
            <option value="">— none —</option>
            {% for t in teams %}
                <option value="{{ t.id }}"{% if task and task.teamId == t.id %} selected{% endif %}>
                    {{ t.name }}
                </option>
            {% endfor %}
        </select>
    </div>

    <div class="col-md-4">
        <label for="parent_id" class="form-label">Parent task</label>
        <select class="form-select" id="parent_id" name="parent_id">
            <option value="">— none (root task) —</option>
            {% for p in parentOptions %}
                <option value="{{ p.id }}"{% if task and task.parentId == p.id %} selected{% endif %}>
                    {{ p.slug }} · {{ p.title }}
                </option>
            {% endfor %}
        </select>
    </div>

    <div class="col-12">
        <label for="url" class="form-label">External URL</label>
        <input type="url" class="form-control" id="url" name="url"
               value="{{ task.url ?? '' }}">
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            {% if task is null %}Create{% else %}Save{% endif %}
        </button>
        <a href="/" class="btn btn-outline-secondary">Cancel</a>
        {% if task is not null %}
            <button type="submit" formaction="/tasks/{{ task.id|url_encode }}/delete"
                    formmethod="post" class="btn btn-outline-danger ms-auto"
                    onclick="return confirm('Soft-delete this task?');">
                Delete
            </button>
        {% endif %}
    </div>
</form>

{% if task is not null %}

{# ── Tags section (UI-02) ── #}
<hr class="my-4">
<div class="row g-3">
    <div class="col-md-6">
        <h2 class="h5">Tags</h2>
        <div class="d-flex flex-wrap gap-1 mb-2">
            {% if currentTags is empty %}
                <span class="text-muted small">No tags yet.</span>
            {% else %}
                {% for tag in currentTags %}
                    <span class="badge bg-primary">
                        {{ tag }}
                        <form method="post" action="/tasks/{{ task.id|url_encode }}/tags/{{ tag|url_encode }}/remove"
                              class="d-inline ms-1">
                            <button type="submit" class="btn-close btn-close-white btn-sm"
                                    aria-label="Remove tag {{ tag }}" style="filter:none;font-size:0.6rem;"></button>
                        </form>
                    </span>
                {% endfor %}
            {% endif %}
        </div>
        <form method="post" action="/tasks/{{ task.id|url_encode }}/tags" class="input-group input-group-sm">
            <input type="text" name="tag" class="form-control" placeholder="new-tag" required pattern="[a-z0-9][a-z0-9-]*">
            <button type="submit" class="btn btn-outline-primary">Add tag</button>
        </form>
    </div>

    {# ── Dependencies section (UI-02) ── #}
    <div class="col-md-6">
        <h2 class="h5">Prerequisites</h2>
        {% if currentDeps is empty %}
            <p class="text-muted small">No prerequisites.</p>
        {% else %}
            <ul class="list-group list-group-flush mb-2">
                {% for dep in currentDeps %}
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <a href="/tasks/{{ dep.id|url_encode }}">{{ dep.slug }} · {{ dep.title }}</a>
                    <form method="delete" action="/tasks/{{ task.id|url_encode }}/dependencies/{{ dep.id|url_encode }}"
                          class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                    </form>
                </li>
                {% endfor %}
            </ul>
        {% endif %}
        <form method="post" action="/tasks/{{ task.id|url_encode }}/dependencies"
              class="input-group input-group-sm">
            <input type="text" name="prereq_id" class="form-control font-monospace"
                   placeholder="prerequisite task UUID" required>
            <button type="submit" class="btn btn-outline-secondary">Add prereq</button>
        </form>
    </div>
</div>

{% endif %}
{% endblock %}

{
    "name": "task-tracker/admin",
    "description": "Task Tracker v1.0 — admin Slim 4 app (binds 127.0.0.1:8080, full CRUD against shared data/).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.14",
        "task-tracker/core": "*@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "TaskTracker\\Admin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TaskTracker\\Admin\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../lib",
            "options": {
                "symlink": false
            }
        }
    ],
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

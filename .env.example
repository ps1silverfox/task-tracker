# Task Tracker v1.0 — environment configuration
#
# Copy this file to `.env` in the project root for local dev, or set the same
# keys via Apache `SetEnv` in the production vhost. Real environment variables
# always take precedence over `.env` (phpdotenv runs in immutable mode).

# Filesystem storage paths. Leave blank to use <project-root>/data and <project-root>/logs.
DATA_DIR=
LOG_DIR=

# SMTP relay for notifications. Leave SMTP_HOST blank to disable email features.
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=task-tracker@example.com

# Public-facing base URL embedded in email links.
BASE_URL=http://localhost

# IANA timezone used when rendering timestamps. Storage is always UTC.
TIMEZONE=UTC

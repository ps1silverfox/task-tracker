{
    "name": "task-tracker/workspace",
    "description": "Task Tracker v1.0 — flat-file team task tracker (workspace root, references lib/ + apps/admin + apps/public).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "TaskTracker\\Tests\\Integration\\": "tests/integration/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "./lib",
            "options": {
                "symlink": false
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "task-tracker": {
            "components": [
                "lib",
                "apps/admin",
                "apps/public"
            ],
            "license-policy": "docs/license-policy.md"
        }
    }
}
